{
  "name": "@pi-work/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first approval-led agent workspace",
  "author": "Pi Work contributors",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "package": "pnpm icons && pnpm build && pnpm prepare:pi-runtime && electron-builder --publish never",
    "icons": "node scripts/generate-icons.mjs",
    "prepare:pi-runtime": "tsx scripts/prepare-pi-runtime.mts",
    "verify:pi-runtime": "tsx scripts/verify-pi-runtime.mts"
  },
